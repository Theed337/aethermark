; Aethermark - 3D Koop-Roguelite (Arbeitstitel)
config_version=5

[application]

config/name="Aethermark"
config/version="0.9.7"
config/description="3D-Fantasy-Action-Roguelite mit Koop-Ausrichtung (Arbeitstitel)"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
InputSetup="*res://scripts/autoload/input_setup.gd"
RunState="*res://scripts/autoload/run_state.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.12, 1)
